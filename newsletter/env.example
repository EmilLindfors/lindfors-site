# lindfors-newsletter. Copy to /etc/lindfors-newsletter.env and chmod 600 -- this file
# holds the database password, the sender's app password and the signing secrets.
#
# Every variable is required unless it says otherwise, and a missing one is fatal at
# startup rather than at the first request. Every URL except the three public ones
# (SITE_URL, PUBLIC_URL, OIDC_ISSUER) points at loopback and must be http://: the binary
# carries no TLS stack, which is what makes cross-compiling it for this host a plain
# `cargo build --target`, and everything it talks to is a port on this same machine.

# Where to listen. Loopback: nginx is what reaches this, and it decides which name may
# reach which paths (newsletter.lindfors.no gets three routes, admin.lindfors.no the
# rest). Do not bind 0.0.0.0.
ADMIN_BIND=127.0.0.1:8788

# --- The site ---------------------------------------------------------------

# Where links in mail point readers, and the origin the signup form posts from (its
# www. variant is allowed too).
SITE_URL=https://lindfors.no

# The same site reached from this process: the issue bodies (static/newsletter/<slug>.md)
# and recent.json for the welcome mail. Cloudflare Pages speaks only TLS, so this is an
# nginx listener on loopback that proxies to it -- the last server block in
# /etc/nginx/http.d/newsletter.lindfors.no.conf.
SITE_INTERNAL_URL=http://127.0.0.1:8448

# Where the confirmation and unsubscribe links point: this service's public name.
PUBLIC_URL=https://newsletter.lindfors.no

# --- State ------------------------------------------------------------------

# The Postgres on this box, as the `newsletter` role, which owns the three tables in
# schema.sql and nothing else. scram-sha-256 over loopback; the pg_hba line for this
# pair sits above the older blanket trust line on purpose.
DATABASE_URL=postgres://newsletter:PASSWORD@127.0.0.1:5432/newsletter

# --- Secrets ----------------------------------------------------------------

# Signs the confirmation and unsubscribe links (openssl rand -hex 32). Rotating it
# invalidates every confirmation link not yet clicked -- at most 48 hours' worth, the
# entire revocation story -- and every unsubscribe link in delivered mail, which
# survives only because the typed-address form at /api/unsubscribe needs no token.
CONFIRM_SECRET=

# Pseudonymises addresses in the events table. Must NOT be CONFIRM_SECRET: that one is
# meant to be rotated, and a rotation would orphan every event ever written. Meant to
# be stable for the life of the log; the same value the Worker used, so old rows match.
EVENT_LOG_SECRET=

# Seals every address at rest: XChaCha20-Poly1305, 32 bytes as 64 hex characters
# (openssl rand -hex 32). The addresses exist nowhere else, so losing this key loses
# the list -- keep a second copy in the password manager. Rotating it means decrypting
# and re-sealing every row, which no command does yet.
DATA_KEY=

# What `site-tools newsletter send` presents to /api/send-newsletter. The same value as
# ADMIN_KEY in the site repo's .env.
ADMIN_KEY=

# --- Sending mail (Stalwart, over loopback) ----------------------------------

# Stalwart's plain HTTP listener; the code appends /jmap/.
JMAP_API_URL=http://127.0.0.1:8080

# The account mail goes out from, and an app password for it. Never the account's
# real password: an app password can be revoked on its own.
JMAP_SENDER_USER=postmaster@lindfors.no
JMAP_SENDER_PASSWORD=

# That account's JMAP account id and identity id, as the Worker had them. Re-resolve
# against /jmap/session if the account is ever recreated.
JMAP_ACCOUNT_ID=c2
JMAP_IDENTITY_ID=b

# Optional. The From: header.
#MAIL_FROM=postmaster@lindfors.no
#MAIL_FROM_NAME=Emil Lindfors

# --- The dashboard's sign-in (Kanidm on idm.lindfors.no) ----------------------

# The public issuer, handed to the browser; the same client reached over loopback
# through nginx's plain-HTTP front for kanidmd (127.0.0.1:8447); the public client id;
# and the one account allowed in, by its Kanidm UUID. See README.md.
OIDC_ISSUER=https://idm.lindfors.no/oauth2/openid/lindfors-admin
OIDC_INTERNAL_ISSUER=http://127.0.0.1:8447/oauth2/openid/lindfors-admin
OIDC_CLIENT_ID=lindfors-admin
ADMIN_SUBJECT=abda274b-7b45-4811-8b83-c1ed680d8b64

# --- OpenObserve (the Readers section) --------------------------------------

# Optional as a group: leave O2_URL unset and the page has no Readers section. A
# service account in the read-only role agent_readonly; the token is only shown once,
# at creation.
O2_URL=http://127.0.0.1:5080
O2_ORG=default
O2_USER=lindfors-admin@lindfors.no
O2_TOKEN=
