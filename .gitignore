# Build output
public/

# Downloaded font source files (can be re-downloaded)
fonts/
!static/fonts/

# Rust build artifacts
target/

# wrangler dev local state (miniflare cache, D1/KV shims)
.wrangler/

# Generated PDFs and audio are committed (built locally before deploy)

# Per-block TTS output, keyed by content hash. Rebuildable, and large.
.audio-cache/

# Symlinks
zotero-cite

# Claude Code local files
.claude/

# OS files
.DS_Store
Thumbs.db

# Editor files
*.swp
*.swo
*~
.vscode/
.idea/

# Secrets
.env
.dev.vars

# Temporary files
*.tmp
*.bak

# The admin service. Runs on the private host, not from this repo, and is not ready
# to be published. Listed here for the same reason the notes below are: deploy.sh
# runs `git add -A`, so an untracked directory that is not ignored gets committed and
# pushed by the next deploy without anyone deciding to publish it. Delete this line
# when it should be tracked -- CLAUDE.md and admin/README.md already describe it.
admin/

# Internal working notes -- not for the public repo. These MUST stay listed here:
# deploy.sh runs `git add -A`, so anything untracked but not ignored gets swept
# back in on the next deploy without anyone deciding to publish it.
CLAUDE.md
NEWSLETTER_IMPROVEMENTS.md
TODO.md
TTS_PLAN.md
telemetry.md
