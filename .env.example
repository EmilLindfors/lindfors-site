# Admin key for protected API endpoints (generate with: openssl rand -hex 32)
ADMIN_KEY=

# Text-to-speech, used by `site-tools audio`. Real environment variables win over
# anything set here.
#
# TTS_BACKEND   fish (POST /v1/tts) or openai (POST /v1/audio/speech)
# TTS_BASE_URL  point this at the local GPU box once it is up
# TTS_MODEL     s2.1-pro-free is free through 2026-08-31; s2.1-pro after that
# TTS_VOICE     Fish reference_id from the voice library; blank uses the default
TTS_BACKEND=fish
TTS_BASE_URL=https://api.fish.audio
TTS_API_KEY=
TTS_MODEL=s2.1-pro-free
TTS_VOICE=

# Send log (WebDAV collection on Stalwart), for `site-tools newsletter check-sendlog`.
# The probe writes and deletes one throwaway file; it never sends mail. The Worker gets
# its own copies from wrangler vars/secrets -- these are only for running the check
# locally. JMAP_LIST_USER needs DAV access to the collection.
SEND_LOG_URL=https://mail.example.com/dav/file/postmaster/newsletter-sent
JMAP_LIST_USER=
JMAP_LIST_PASSWORD=
