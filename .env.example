# Admin key for protected API endpoints (generate with: openssl rand -hex 32)
ADMIN_KEY=

# Text-to-speech, used by `site-tools audio`. Real environment variables win over
# anything set here.
#
# TTS_BACKEND   fish (POST /v1/tts) or openai (POST /v1/audio/speech)
# TTS_BASE_URL  point this at the local GPU box once it is up
# TTS_MODEL     s2.1-pro-free is free through 2026-08-31; s2.1-pro after that
# TTS_VOICE     Fish reference_id from the voice library; blank uses the default
TTS_BACKEND=fish
TTS_BASE_URL=https://api.fish.audio
TTS_API_KEY=
TTS_MODEL=s2.1-pro-free
TTS_VOICE=

# Image generation, used by `site-tools hero`. Never run by the build.
# OPENROUTER_IMAGE_MODEL is optional; google/gemini-3.1-flash-lite-image is the default.
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=

# The newsletter service on mail.lindfors.no pseudonymises addresses in its event table
# under this. The same value lives in /etc/lindfors-newsletter.env on the host; it is
# here so the two never drift, and it must never equal the service's CONFIRM_SECRET.
EVENT_LOG_SECRET=
